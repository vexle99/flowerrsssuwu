BG_RGB = (24, 28, 38)
ASPECT = 2.0  

def clamp(v, lo, hi):
    return lo if v < lo else (hi if v > hi else v)

def lerp(a, b, t):
    return a + (b - a) * t

def smoothstep(t):
    t = clamp(t, 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

def lerp_rgb(c1, c2, t):
    t = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * t),
        int(c1[1] + (c2[1] - c1[1]) * t),
        int(c1[2] + (c2[2] - c1[2]) * t),
    )

def scale_rgb(c, factor):
    return (
        int(clamp(c[0] * factor, 0, 255)),
        int(clamp(c[1] * factor, 0, 255)),
        int(clamp(c[2] * factor, 0, 255)),
    )

def vec_norm(v):
    length = math.sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2])
    if length < 1e-9:
        return (0.0, -1.0, 0.0)
    return (v[0] / length, v[1] / length, v[2] / length)

def vec_cross(a, b):
    return (
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0],
    )

def project(x, y, z, rot_c, rot_s, cx, cy, unit):
    rx = x * rot_c + z * rot_s
    rz = -x * rot_s + z * rot_c
    cam_dist = 4.2
    persp = cam_dist / max(0.8, cam_dist - rz)
    sx = cx + rx * persp * unit * ASPECT
    sy = cy + y * persp * unit
    depth_shade = clamp(0.62 + 0.40 * ((rz + 0.85) / 1.70), 0.45, 1.08)
    return sx, sy, rz, depth_shade

class Canvas:
    def __init__(self, w, h):
        self.w = w
        self.h = h
        self.chars = [" "] * (w * h)
        self.colors = [None] * (w * h)
        self.zbuf = [-1e9] * (w * h)

    def put(self, x, y, ch, rgb, z=0.0):
        ix = int(round(x))
        iy = int(round(y))
        if 0 <= ix < self.w and 0 <= iy < self.h:
            idx = iy * self.w + ix
            if z >= self.zbuf[idx]:
                self.zbuf[idx] = z
                self.chars[idx] = ch
                self.colors[idx] = rgb

    def render(self):
        bg_esc = f"\x1b[48;2;{BG_RGB[0]};{BG_RGB[1]};{BG_RGB[2]}m" if USE_DARK_BG else ""
        lines = []
        w = self.w
        chars = self.chars
        colors = self.colors
        for y in range(self.h):
            row_start = y * w
            out = [bg_esc] if bg_esc else []
            last_rgb = None
            for x in range(w):
                idx = row_start + x
                ch = chars[idx]
                rgb = colors[idx]
                if ch == " " or rgb is None:
                    out.append(" ")
                else:
                    if rgb != last_rgb:
                        out.append(f"\x1b[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m")
                        last_rgb = rgb
                    out.append(ch)
            lines.append("".join(out))
        return "\x1b[H" + "\n".join(lines) + "\x1b[0m"

def make_particles():
    rng = random.Random(42)
    stars = [
        (0.89, 0.09, 0.0, (95, 255, 175)),
        (0.11, 0.80, 2.1, (95, 255, 175)),
        (0.14, 0.14, 4.0, (130, 225, 255)),
